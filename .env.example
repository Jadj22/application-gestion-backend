# Copier ce fichier en .env et remplir les valeurs

# Neon Postgres (pooled)
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require
# Durée de vie des connexions PostgreSQL réutilisées (0 avec pooler Neon).
DB_CONN_MAX_AGE=0

DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*
DJANGO_SECRET_KEY=django-insecure-change-me

ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=7

CORS_ALLOW_ALL=True

# Neon Object Storage (S3-compatible) — injecté aussi via `neon env pull`
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=https://br-xxx.storage.c-9.us-east-2.aws.neon.tech
AWS_REGION=us-east-2
AWS_STORAGE_BUCKET_NAME=assets

# IDs clients OAuth Google autorisés (séparés par des virgules)
GOOGLE_CLIENT_IDS=976579848816-0snvj73v3bhvh28prtmaqhn8rqlfleik.apps.googleusercontent.com

# Gemini — description automatique des photos d'articles (Sprint 10)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash